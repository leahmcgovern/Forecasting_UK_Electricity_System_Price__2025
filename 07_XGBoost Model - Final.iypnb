nk.fitted span {\n","  /* fitted */\n","  background: var(--sklearn-color-fitted-level-0);\n","  border: var(--sklearn-color-fitted-level-3);\n","}\n","\n",".sk-estimator-doc-link:hover span {\n","  display: block;\n","}\n","\n","/* \"?\"-specific style due to the `<a>` HTML tag */\n","\n","#sk-container-id-1 a.estimator_doc_link {\n","  float: right;\n","  font-size: 1rem;\n","  line-height: 1em;\n","  font-family: monospace;\n","  background-color: var(--sklearn-color-background);\n","  border-radius: 1rem;\n","  height: 1rem;\n","  width: 1rem;\n","  text-decoration: none;\n","  /* unfitted */\n","  color: var(--sklearn-color-unfitted-level-1);\n","  border: var(--sklearn-color-unfitted-level-1) 1pt solid;\n","}\n","\n","#sk-container-id-1 a.estimator_doc_link.fitted {\n","  /* fitted */\n","  border: var(--sklearn-color-fitted-level-1) 1pt solid;\n","  color: var(--sklearn-color-fitted-level-1);\n","}\n","\n","/* On hover */\n","#sk-container-id-1 a.estimator_doc_link:hover {\n","  /* unfitted */\n","  background-color: var(--sklearn-color-unfitted-level-3);\n","  color: var(--sklearn-color-background);\n","  text-decoration: none;\n","}\n","\n","#sk-container-id-1 a.estimator_doc_link.fitted:hover {\n","  /* fitted */\n","  background-color: var(--sklearn-color-fitted-level-3);\n","}\n","</style><div id=\"sk-container-id-1\" class=\"sk-top-container\"><div class=\"sk-text-repr-fallback\"><pre>XGBRegressor(base_score=None, booster=None, callbacks=None,\n","             colsample_bylevel=None, colsample_bynode=None,\n","             colsample_bytree=0.8, device=None, early_stopping_rounds=None,\n","             enable_categorical=False, eval_metric=None, feature_types=None,\n","             feature_weights=None, gamma=5, grow_policy=None,\n","             importance_type=None, interaction_constraints=None,\n","             learning_rate=0.01, max_bin=None, max_cat_threshold=None,\n","             max_cat_to_onehot=None, max_delta_step=None, max_depth=6,\n","             max_leaves=None, min_child_weight=10, missing=nan,\n","             monotone_constraints=None, multi_strategy=None, n_estimators=1000,\n","             n_jobs=-1, num_parallel_tree=None, ...)</pre><b>In a Jupyter environment, please rerun this cell to show the HTML representation or trust the notebook. <br />On GitHub, the HTML representation is unable to render, please try loading this page with nbviewer.org.</b></div><div class=\"sk-container\" hidden><div class=\"sk-item\"><div class=\"sk-estimator fitted sk-toggleable\"><input class=\"sk-toggleable__control sk-hidden--visually\" id=\"sk-estimator-id-1\" type=\"checkbox\" checked><label for=\"sk-estimator-id-1\" class=\"sk-toggleable__label fitted sk-toggleable__label-arrow\"><div><div>XGBRegressor</div></div><div><a class=\"sk-estimator-doc-link fitted\" rel=\"noreferrer\" target=\"_blank\" href=\"https://xgboost.readthedocs.io/en/release_3.1.0/python/python_api.html#xgboost.XGBRegressor\">?<span>Documentation for XGBRegressor</span></a><span class=\"sk-estimator-doc-link fitted\">i<span>Fitted</span></span></div></label><div class=\"sk-toggleable__content fitted\"><pre>XGBRegressor(base_score=None, booster=None, callbacks=None,\n","             colsample_bylevel=None, colsample_bynode=None,\n","             colsample_bytree=0.8, device=None, early_stopping_rounds=None,\n","             enable_categorical=False, eval_metric=None, feature_types=None,\n","             feature_weights=None, gamma=5, grow_policy=None,\n","             importance_type=None, interaction_constraints=None,\n","             learning_rate=0.01, max_bin=None, max_cat_threshold=None,\n","             max_cat_to_onehot=None, max_delta_step=None, max_depth=6,\n","             max_leaves=None, min_child_weight=10, missing=nan,\n","             monotone_constraints=None, multi_strategy=None, n_estimators=1000,\n","             n_jobs=-1, num_parallel_tree=None, ...)</pre></div> </div></div></div></div>"]},"metadata":{},"execution_count":19}],"source":["syspricemodel = XGBRegressor()\n","\n","syspricemodel_optimised = XGBRegressor(\n","  #variable parameters (fixed to values in comment at top ^^)\n","    n_estimators=1000,\n","    max_depth=6,\n","    learning_rate=0.01,\n","    min_child_weight=10,\n","\n","    # Fixed Parameters\n","    subsample=0.8,\n","    colsample_bytree=0.8,\n","    gamma=5,\n","    reg_alpha=10,\n","    n_jobs=-1,\n","    random_state=42,\n","    objective='reg:squarederror',\n","    )\n","\n","syspricemodel.fit(train_X, train_y)\n","syspricemodel_optimised.fit(train_X, train_y)"]},{"cell_type":"code","execution_count":20,"metadata":{"id":"6Gro5ibsNAvf","executionInfo":{"status":"ok","timestamp":1767739181024,"user_tz":0,"elapsed":2,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}}},"outputs":[],"source":["###unoptimised results"]},{"cell_type":"code","execution_count":21,"metadata":{"id":"sduc5D1dNAxk","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1767739181157,"user_tz":0,"elapsed":131,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"fc403747-8de7-4d2e-8f43-799a7aee776e"},"outputs":[{"output_type":"stream","name":"stdout","text":["Test Mean Absolute Error : 23.833334869193358\n","Train Mean Absolute Error : 28.407865362278613\n","\n","Test R² Score: 0.5591471235835974\n","Train R² Score: 0.9095418360553685\n"]}],"source":["###UNOPTIMISED RESULTS\n","\n","test_predictions = syspricemodel.predict(test_X)\n","train_predictions = syspricemodel.predict(train_X)\n","\n","from sklearn.metrics import mean_absolute_error, r2_score\n","print(\"Test Mean Absolute Error : \" + str(mean_absolute_error(test_y,test_predictions)))\n","print(\"Train Mean Absolute Error : \" + str(mean_absolute_error(train_y,train_predictions)))\n","print()\n","print(\"Test R² Score: \" + str(r2_score(test_y,test_predictions)))\n","print(\"Train R² Score: \" + str(r2_score(train_y,train_predictions)))\n","\n","## High train R^2 and not as high test suggests overfitting"]},{"cell_type":"code","execution_count":22,"metadata":{"id":"g8pYMqgaNA09","colab":{"base_uri":"https://localhost:8080/","height":0},"executionInfo":{"status":"ok","timestamp":1767739181379,"user_tz":0,"elapsed":221,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"3b18d05b-d1e0-4126-9f07-8b87123bef35"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.figure(figsize=(8, 6))\n","plt.scatter(test_y, test_predictions, alpha=0.3, color='teal')\n","plt.plot([test_y.min(), test_y.max()], [test_y.min(), test_y.max()], 'r--', lw=2)\n","plt.xlabel('Test System Price')\n","plt.ylabel('Base XGBoost Model Predicted System Price')\n","plt.title(f'Base XGBoost Model Predicted System Price vs. Test System Price (R² Score: {r2_score(test_y,test_predictions):.4f})')\n","plt.show()\n"]},{"cell_type":"code","execution_count":23,"metadata":{"id":"sfUI88QGPWeX","colab":{"base_uri":"https://localhost:8080/","height":490},"executionInfo":{"status":"ok","timestamp":1767739181786,"user_tz":0,"elapsed":404,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"cb63c84c-0dda-43eb-88e2-7c24775c6edd"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x800 with 0 Axes>"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.figure(figsize=(10, 8))\n","plot_importance(syspricemodel, max_num_features=15) # Top 15 features\n","plt.title(f'Base XGBoost Model Feature Importance')\n","plt.show()\n","\n","# I tried running the model without market index price. R2 was 0.26. with gas price as the most impt feature"]},{"cell_type":"code","execution_count":24,"metadata":{"id":"_WmBcHtBPWgp","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1767739183006,"user_tz":0,"elapsed":1218,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"310821c6-c843-4454-ea56-bfd1bd58ffc0"},"outputs":[{"output_type":"stream","name":"stdout","text":["Optimised system price model results!!\n","Test Mean Absolute Error : 21.04872952939815\n","Train Mean Absolute Error : 33.999207313429274\n","\n","Test R² Score: 0.6631371861470433\n","Train R² Score: 0.8446668826261694\n"]}],"source":["###OPTIMISED RESULTS\n","\n","optimised_test_predictions = syspricemodel_optimised.predict(test_X)\n","optimised_train_predictions = syspricemodel_optimised.predict(train_X)\n","from sklearn.metrics import mean_absolute_error, r2_score\n","print(\"Optimised system price model results!!\")\n","print(\"Test Mean Absolute Error : \" + str(mean_absolute_error(test_y,optimised_test_predictions)))\n","print(\"Train Mean Absolute Error : \" + str(mean_absolute_error(train_y,optimised_train_predictions)))\n","print()\n","print(\"Test R² Score: \" + str(r2_score(test_y,optimised_test_predictions)))\n","print(\"Train R² Score: \" + str(r2_score(train_y,optimised_train_predictions)))"]},{"cell_type":"code","execution_count":25,"metadata":{"id":"jsUY83ePPWnt","colab":{"base_uri":"https://localhost:8080/","height":0},"executionInfo":{"status":"ok","timestamp":1767739183232,"user_tz":0,"elapsed":207,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"a11dfc9e-be6a-4b75-9c20-a35a87cf23f6"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.figure(figsize=(8, 6))\n","plt.scatter(test_y, optimised_test_predictions, alpha=0.3, color='teal')\n","plt.plot([test_y.min(), test_y.max()], [test_y.min(), test_y.max()], 'r--', lw=2)\n","plt.xlabel('Test System Price')\n","plt.ylabel('Optimised XGBoost Predicted System Price')\n","plt.title(f'Optimised XGBoost Predicted System Price vs. Test System Price (R² Score: {r2_score(test_y,optimised_test_predictions):.4f})')\n","plt.show()"]},{"cell_type":"code","execution_count":26,"metadata":{"id":"yK4K7AW5PlPs","colab":{"base_uri":"https://localhost:8080/","height":490},"executionInfo":{"status":"ok","timestamp":1767739183442,"user_tz":0,"elapsed":209,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"7dbc3b56-ef12-4a7d-cf3d-3632d2fb47eb"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x800 with 0 Axes>"]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 640x480 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["plt.figure(figsize=(10, 8))\n","plot_importance(syspricemodel_optimised, max_num_features=15) # Top 15 features\n","plt.title(f'Optimised XGBoost Model Feature Importance')\n","plt.show()\n","\n","# I tried running the model without market index price. R2 was 0.26. with gas price as the most impt feature"]},{"cell_type":"code","execution_count":27,"metadata":{"id":"gCLcd-b7PlR-","colab":{"base_uri":"https://localhost:8080/","height":564},"executionInfo":{"status":"ok","timestamp":1767739184019,"user_tz":0,"elapsed":576,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"6b9bcc07-d5a1-4b55-b590-90da3b3d8b8d"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["# Plot the residuals of one graph against the residuals of the other\n","base_model_residuals = test_y - test_predictions\n","base_model_residuals_index = np.arange(len(base_model_residuals))\n","\n","optimised_model_residuals = test_y - optimised_test_predictions\n","optimised_model_residuals_index = np.arange(len(optimised_model_residuals))\n","\n","\"\"\"\n","# Plotting the second set\n","plt.scatter(base_model_residuals_index, base_model_residuals, color='red', alpha = 0.5, label='Base model residuals')\n","plt.scatter(optimised_model_residuals_index, optimised_model_residuals, color='blue', alpha = 0.5, label='Group B', marker='o')\n","\n","# Adding details\n","plt.title('Comparison of Two Data Sets')\n","plt.xlabel('X-Axis Label')\n","plt.ylabel('Y-Axis Label')\n","plt.legend() # This displays the labels defined in the scatter calls\n","plt.grid(True, linestyle='--', alpha=0.6)\n","\n","# Show the plot\n","plt.show()\n","\"\"\"\n","\n","plt.figure(figsize=(10, 6))\n","\n","# Plot the distribution (Density) of Actuals vs Predictions\n","sns.kdeplot(test_y, label='Test System Prices', fill=True, color='blue', alpha=0.3)\n","sns.kdeplot(test_predictions, label='Unoptimised XGBOOST Model System Price Predictions', fill=True, color='red', alpha=0.3)\n","sns.kdeplot(optimised_test_predictions, label='Optimised XGBOOST Model System Price Predictions', fill=True, color='green', alpha=0.3)\n","#sns.kdeplot(train_y, label='Actual Training Prices', fill=True, color='red', alpha=0.3)\n","\n","\n","plt.xlim(-50, 500)  # Limit x-axis to focus on the relevant range\n","plt.title(\"XGBoost Model Predictions Comparison\")\n","plt.xlabel(\"System Price (£/MWh)\")\n","plt.legend()\n","plt.show()"]},{"cell_type":"code","execution_count":28,"metadata":{"id":"4uBKPWvqPlUl","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1767739184030,"user_tz":0,"elapsed":9,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"7e1af678-b9c0-406c-e151-25005cc50713"},"outputs":[{"output_type":"stream","name":"stdout","text":["--- Model Performance Report ---\n","MAE on Normal Days (£0-£150):  £19.78\n","MAE on Stress Days (>£150):    £69.53\n","--------------------------------\n","Number of Stress Events in Test Set: 445\n"]}],"source":["# 1. Define a \"Stress\" threshold (e.g., Price > £150)\n","threshold = 150\n","\n","# 2. Create masks to slice the data\n","stress_mask = test_y > threshold\n","normal_mask = test_y <= threshold\n","\n","# 3. Calculate MAE for each slice\n","# We use the mask on both the Actuals (test_y) and Predictions (preds)\n","mae_stress = mean_absolute_error(test_y[stress_mask], optimised_test_predictions[stress_mask])\n","mae_normal = mean_absolute_error(test_y[normal_mask], optimised_test_predictions[normal_mask])\n","\n","print(f\"--- Model Performance Report ---\")\n","print(f\"MAE on Normal Days (£0-£{threshold}):  £{mae_normal:.2f}\")\n","print(f\"MAE on Stress Days (>£{threshold}):    £{mae_stress:.2f}\")\n","print(f\"--------------------------------\")\n","print(f\"Number of Stress Events in Test Set: {np.sum(stress_mask)}\")"]},{"cell_type":"code","execution_count":29,"metadata":{"id":"r7BRlV27PlWp","colab":{"base_uri":"https://localhost:8080/","height":143},"executionInfo":{"status":"ok","timestamp":1767739184044,"user_tz":0,"elapsed":7,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"2b987441-5edc-4de1-fe9f-16dd6c5a01c8"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["\"\\n# 1. Define the threshold\\nthreshold = 150\\n#threshold = test_y.mean() + 1.5*iqr(test_y) #should equal 158.76271257759618\\n\\n# 2. Convert continuous data to binary (1 = Spike, 0 = Normal)\\ny_test_binary = (test_y > threshold).astype(int)\\noptimised_test_predictions_binary = (optimised_test_predictions > threshold).astype(int)\\n\\n# 3. Create Confusion Matrix\\ncm = confusion_matrix(y_test_binary, optimised_test_predictions_binary)\\n\\n# 4. Plot\\nplt.figure(figsize=(6, 5))\\nsns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\\n            xticklabels=['Predicted Normal', 'Predicted Spike'],\\n            yticklabels=['Actual Normal', 'Actual Spike'])\\nplt.title('Did the model catch the Stress Events?')\\nplt.ylabel('Actual')\\nplt.xlabel('Predicted')\\nplt.show()\\n\\n# 5. Print Score\\nprint(classification_report(y_test_binary, optimised_test_predictions_binary, target_names=['Normal', 'Spike']))\\n\""],"application/vnd.google.colaboratory.intrinsic+json":{"type":"string"}},"metadata":{},"execution_count":29}],"source":["from sklearn.metrics import confusion_matrix, classification_report\n","import seaborn as sns\n","from scipy.stats import iqr\n","\n","\"\"\"\n","# 1. Define the threshold\n","threshold = 150\n","#threshold = test_y.mean() + 1.5*iqr(test_y) #should equal 158.76271257759618\n","\n","# 2. Convert continuous data to binary (1 = Spike, 0 = Normal)\n","y_test_binary = (test_y > threshold).astype(int)\n","optimised_test_predictions_binary = (optimised_test_predictions > threshold).astype(int)\n","\n","# 3. Create Confusion Matrix\n","cm = confusion_matrix(y_test_binary, optimised_test_predictions_binary)\n","\n","# 4. Plot\n","plt.figure(figsize=(6, 5))\n","sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n","            xticklabels=['Predicted Normal', 'Predicted Spike'],\n","            yticklabels=['Actual Normal', 'Actual Spike'])\n","plt.title('Did the model catch the Stress Events?')\n","plt.ylabel('Actual')\n","plt.xlabel('Predicted')\n","plt.show()\n","\n","# 5. Print Score\n","print(classification_report(y_test_binary, optimised_test_predictions_binary, target_names=['Normal', 'Spike']))\n","\"\"\""]},{"cell_type":"code","execution_count":30,"metadata":{"id":"ucM0GxlkQMUf","colab":{"base_uri":"https://localhost:8080/","height":820},"executionInfo":{"status":"error","timestamp":1767739184198,"user_tz":0,"elapsed":151,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"18904ba9-152b-4301-e4df-4344ce7a0ce6"},"outputs":[{"output_type":"error","ename":"AttributeError","evalue":"Axes.set() got an unexpected keyword argument 'cmap'","traceback":["\u001b[0;31m---------------------------------------------------------------------------\u001b[0m","\u001b[0;31mAttributeError\u001b[0m                            Traceback (most recent call last)","\u001b[0;32m/tmp/ipython-input-485280580.py\u001b[0m in \u001b[0;36m<cell line: 0>\u001b[0;34m()\u001b[0