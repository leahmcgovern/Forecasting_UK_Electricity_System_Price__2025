,"image/png":"\n"},"metadata":{}}],"source":["plt.figure(figsize=(12, 6))\n","\n","# Plot R2 vs Learning Rate\n","sns.stripplot(\n","    x='learning_rate',\n","    y='Test_R2',\n","    hue='Dataset',\n","    data=all_results,\n","    dodge=True,\n","    jitter=True,\n","    alpha=0.7,\n","    size=8\n",")\n","\n","plt.title(\"Impact of Learning Rate on Model Performance\")\n","plt.ylabel(\"R²\")\n","plt.xlabel(\"Learning Rate\")\n","plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')\n","plt.grid(True, alpha=0.3)\n","plt.ylim(0, 0.7)\n","plt.show()"]},{"cell_type":"code","execution_count":13,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"J-OqQwQcmSTl","executionInfo":{"status":"ok","timestamp":1767739174094,"user_tz":0,"elapsed":21,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"de8dca89-b369-45a8-9a7b-ca243443cd92"},"outputs":[{"output_type":"stream","name":"stdout","text":["Dataset        learning_rate\n","M3 (Original)  0.01             21.048723\n","               0.05             21.800543\n","               0.10             22.709179\n","Name: Test_MAE, dtype: float64\n"]}],"source":["print(all_results.groupby(['Dataset', 'learning_rate'])['Test_MAE'].min())"]},{"cell_type":"code","execution_count":14,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"R-RW46mQEn7h","executionInfo":{"status":"ok","timestamp":1767739174453,"user_tz":0,"elapsed":358,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"e3919f1e-b3f1-471c-f3b6-be56ab9cf612"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 1000x600 with 1 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","# Select the top 10 models by Test_R2\n","top_models = all_results.sort_values('Test_R2', ascending=False).head(10).copy()\n","top_models['Model_Index'] = top_models.index.astype(str)\n","\n","plt.figure(figsize=(10, 6))\n","\n","sns.scatterplot(x='Model_Index', y='Train_R2', data=top_models, color='blue', label='Train R²', s=100)\n","sns.scatterplot(x='Model_Index', y='Test_R2', data=top_models, color='red', label='Test R²', s=100)\n","\n","for i in range(len(top_models)):\n","    plt.vlines(x=top_models['Model_Index'].iloc[i],\n","               ymin=top_models['Test_R2'].iloc[i],\n","               ymax=top_models['Train_R2'].iloc[i],\n","               colors='gray', linestyle='--', alpha=0.5)\n","\n","plt.title(\"The Overfitting Gap: Training vs. Test Performance\")\n","plt.ylabel(\"R² Score\")\n","plt.xlabel(\"Hyperparameter Configuration (Index)\")\n","plt.ylim(0, 1.0)\n","plt.legend()\n","plt.grid(axis='y', alpha=0.3)\n","plt.show()"]},{"cell_type":"code","execution_count":15,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"_4bKoaKumSWd","executionInfo":{"status":"ok","timestamp":1767739174656,"user_tz":0,"elapsed":200,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"feef1437-0477-4b9e-9ba2-dcf6c17d0b15"},"outputs":[{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}],"source":["best_data = xgb_results\n","\n","# Create a pivot table\n","pivot_table = best_data.pivot_table(\n","    index='max_depth',\n","    columns='learning_rate',\n","    values='Test_MAE',\n","    aggfunc='max' # Take the best score if duplicates exist\n",")\n","\n","plt.figure(figsize=(8, 6))\n","sns.heatmap(pivot_table, annot=True, cmap='viridis', fmt=\".3f\",cbar_kws={'label': 'Test MAE'})\n","plt.title(\"M3 MAE Performance Map: Depth vs Learning Rate\")\n","plt.ylabel(\"Max Depth\")\n","plt.xlabel(\"Learning Rate\")\n","plt.show()"]},{"cell_type":"code","execution_count":16,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":0},"id":"DK0OI6flmSZD","executionInfo":{"status":"ok","timestamp":1767739174896,"user_tz":0,"elapsed":239,"user":{"displ