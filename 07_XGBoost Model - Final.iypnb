ic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"gen_gas_mw\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 6094,\n        \"min\": 0,\n        \"max\": 27323,\n        \"num_unique_values\": 10572,\n        \"samples\": [\n          1450,\n          21789,\n          21380\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"gen_pumped_mw\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 358,\n        \"min\": 0,\n        \"max\": 2213,\n        \"num_unique_values\": 1453,\n        \"samples\": [\n          948,\n          604,\n          1142\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"gen_riverhydro_mw\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 241,\n        \"min\": 0,\n        \"max\": 1179,\n        \"num_unique_values\": 1075,\n        \"samples\": [\n          619,\n          419,\n          407\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"gen_nuclear_mw\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 1106,\n        \"min\": 0,\n        \"max\": 5682,\n        \"num_unique_values\": 2133,\n        \"samples\": [\n          4957,\n          3529,\n          3967\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"gen_solar_mw\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2352,\n        \"min\": 0,\n        \"max\": 11594,\n        \"num_unique_values\": 5038,\n        \"samples\": [\n          2644,\n          5431,\n          1583\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"gen_other_mw\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 325,\n        \"min\": 0,\n        \"max\": 2970,\n        \"num_unique_values\": 1522,\n        \"samples\": [\n          394,\n          1386,\n          1845\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"gen_forecastwind_mw\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 5662.239339403178,\n        \"min\": 0.0,\n        \"max\": 21855.757,\n        \"num_unique_values\": 16723,\n        \"samples\": [\n          9326.587,\n          19567.002,\n          786.666\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":6}],"source":["train_X = train_df.drop(columns=\"sysprice_ppmwh\").reset_index(drop = True)\n","train_y = train_df[\"sysprice_ppmwh\"].copy().reset_index(drop = True)\n","test_X = test_df.drop(columns=\"sysprice_ppmwh\").reset_index(drop = True)\n","test_y = test_df[\"sysprice_ppmwh\"].reset_index(drop = True)\n","test_X.head()"]},{"cell_type":"code","execution_count":7,"metadata":{"executionInfo":{"elapsed":38,"status":"ok","timestamp":1767738592356,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"},"user_tz":0},"id":"fJnx7uJ9lkKL"},"outputs":[],"source":["from itertools import product\n","from xgboost import XGBRegressor\n","from sklearn.metrics import mean_absolute_error, r2_score\n","from scipy.stats import iqr\n","\n","\n","# Establishing a more extensive Grid Search (Targeting Overfitting)\n","# Added 'gamma' (Pruning) and 'reg_alpha' (L1 Regularization)\n","xgb_param_grid = {\n","    \"n_estimators\": [1000],\n","    \"max_depth\": [4, 6, 9],             # Depth: Lower = less overfitting\n","    \"learning_rate\": [0.01, 0.05, 0.1], # LR: Lower = more robust\n","    \"min_child_weight\": [10, 20],       # Child Weight: Higher = prevents isolating outliers\n","    \"gamma\": [1, 5],                    # Gamma: Higher = more aggressive pruning (try 1 and 5)\n","    \"reg_alpha\": [0, 10]                # Alpha: L1 Regularization (try 0 and 10)\n","}\n","\n","# Function with Training Metrics\n","def xgb_hyperparam_sweep(\n","    train_df,\n","    test_df,\n","    target_col,\n","    param_grid,\n","    price_spike_threshold=150\n","):\n","    X_train = train_df.drop(columns=[target_col])\n","    y_train = train_df[target_col]\n","    X_test = test_df.drop(columns=[target_col])\n","    y_test = test_df[target_col]\n","\n","    results = []\n","\n","    total_combinations = (\n","        len(param_grid[\"n_estimators\"]) * len(param_grid[\"max_depth\"]) * len(param_grid[\"learning_rate\"]) * len(param_grid[\"min_child_weight\"]) *\n","        len(param_grid[\"gamma\"]) *\n","        len(param_grid[\"reg_alpha\"])\n","    )\n","    print(f\"Starting sweep with {total_combinations} combinations...\")\n","\n","    # Expanded loop to include Gamma and Alpha\n","    for n_est, depth, lr, child_weight, g, alpha in product(\n","        param_grid[\"n_estimators\"],\n","        param_grid[\"max_depth\"],\n","        param_grid[\"learning_rate\"],\n","        param_grid[\"min_child_weight\"],\n","        param_grid[\"gamma\"],\n","        param_grid[\"reg_alpha\"]\n","    ):\n","\n","        xgb_model = XGBRegressor(\n","            n_estimators=n_est,\n","            max_depth=depth,\n","            learning_rate=lr,\n","            min_child_weight=child_weight,\n","            gamma=g,                    # Now dynamic\n","            reg_alpha=alpha,            # Now dynamic\n","            subsample=0.8,\n","            colsample_bytree=0.8,\n","            n_jobs=-1,\n","            random_state=42,\n","            objective='reg:squarederror'\n","        )\n","\n","        # Fit Model\n","        xgb_model.fit(X_train, y_train)\n","\n","        # Predict on TRAINING Set (To check Overfitting)\n","        y_train_pred = xgb_model.predict(X_train)\n","        train_mae = mean_absolute_error(y_train, y_train_pred)\n","        train_r2 = r2_score(y_train, y_train_pred)\n","\n","        # Predict on TEST Set (To check Performance)\n","        y_pred = xgb_model.predict(X_test)\n","        mae = mean_absolute_error(y_test, y_pred)\n","        r2 = r2_score(y_test, y_pred)\n","\n","        # Check Stress Performance\n","        is_stress = y_test > price_spike_threshold\n","        not_stress = y_test <= price_spike_threshold\n","\n","        if is_stress.sum() > 0:\n","            stress_mae = mean_absolute_error(y_test[is_stress], y_pred[is_stress])\n","        else:\n","            stress_mae = np.nan\n","\n","        if not_stress.sum() > 0:\n","            not_stress_mae = mean_absolute_error(y_test[not_stress], y_pred[not_stress])\n","        else:\n","            stress_mae = np.nan\n","\n","        # Save Results\n","        results.append({\n","            \"n_estimators\": n_est,\n","            \"max_depth\": depth,\n","            \"learning_rate\": lr,\n","            \"min_child_weight\": child_weight,\n","            \"gamma\": g,\n","            \"reg_alpha\": alpha,\n","            \"Train_MAE\": train_mae,\n","            \"Test_MAE\": mae,\n","            \"Train_R2\": train_r2,\n","            \"Test_R2\": r2,\n","            \"Stress_MAE\": stress_mae,\n","            \"not_stress_MAE\": not_stress_mae,\n","            \"Overfit_Gap\": train_r2 - r2 # Calculated Metric\n","        })\n","\n","    # Return sorted by Test R2 (descending)\n","    return pd.DataFrame(results).sort_values(\"Test_R2\", ascending=False)"]},{"cell_type":"code","execution_count":8,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":401},"id":"lTPZoca8mSCu","executionInfo":{"status":"ok","timestamp":1767739173680,"user_tz":0,"elapsed":581323,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"}},"outputId":"c435128a-fa7b-412d-88c3-2d65da169bfe"},"outputs":[{"output_type":"stream","nam