e":"stdout","text":["<class 'pandas.core.frame.DataFrame'>\n","DatetimeIndex: 67262 entries, 2021-04-01 00:00:00 to 2025-03-31 23:30:00\n","Data columns (total 16 columns):\n"," #   Column                  Non-Null Count  Dtype  \n","---  ------                  --------------  -----  \n"," 0   temp_degcels            67262 non-null  float64\n"," 1   gasprice_ppmwh          67262 non-null  float64\n"," 2   marketindexprice_ppmwh  67262 non-null  float64\n"," 3   sysprice_ppmwh          67262 non-null  float64\n"," 4   deratedmargin_mw        67262 non-null  float64\n"," 5   net_physnotif_mw        67262 non-null  int64  \n"," 6   dem_forecast_mw         67262 non-null  int64  \n"," 7   gen_interconnector_mw   67262 non-null  int64  \n"," 8   gen_biomass_mw          67262 non-null  int64  \n"," 9   gen_gas_mw              67262 non-null  int64  \n"," 10  gen_pumped_mw           67262 non-null  int64  \n"," 11  gen_riverhydro_mw       67262 non-null  int64  \n"," 12  gen_nuclear_mw          67262 non-null  int64  \n"," 13  gen_solar_mw            67262 non-null  int64  \n"," 14  gen_other_mw            67262 non-null  int64  \n"," 15  gen_forecastwind_mw     67262 non-null  float64\n","dtypes: float64(6), int64(10)\n","memory usage: 8.7 MB\n"]}],"source":["df = pd.read_csv(\"/content/drive/MyDrive/Energy Data Analysis Group 3 Coursework/data/Feature engineering and transformation/modelling_dataset_base.csv\")\n","# Function to parse the custom date_sp format (YYYY-MM-DD-HH where HH is period 01-48)\n","def parse_date_sp_to_datetime(date_sp_str):\n","    date_part = date_sp_str[:-3]  # 'YYYY-MM-DD'\n","    period_part = int(date_sp_str[-2:])  # '01' to '48'\n","\n","    # Base datetime object from YYYY-MM-DD\n","    dt_obj = pd.to_datetime(date_part)\n","\n","    # Convert period number to actual hours and minutes\n","    # Period 1 = 00:00, Period 2 = 00:30, ..., Period 48 = 23:30\n","    hours = (period_part - 1) // 2\n","    minutes = ((period_part - 1) % 2) * 30\n","\n","    return dt_obj + pd.Timedelta(hours=hours, minutes=minutes)\n","\n","# Apply this conversion to the 'date_sp' column in the entire DataFrame\n","df['date_sp'] = df['date_sp'].apply(parse_date_sp_to_datetime)\n","\n","# Set date_sp as the index\n","df = df.set_index('date_sp').sort_index()\n","\n","print(\"DataFrame with 'date_sp' converted to datetime:\")\n","display(df.head())\n","df.info()"]},{"cell_type":"code","execution_count":5,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":431},"executionInfo":{"elapsed":30,"status":"ok","timestamp":1767738592207,"user":{"displayName":"Guangwei chua","userId":"00599191917559462008"},"user_tz":0},"id":"1EEsgPaylkGB","outputId":"30120817-e149-428d-e400-6399d22ab9c5"},"outputs":[{"output_type":"execute_result","data":{"text/plain":["                     temp_degcels  gasprice_ppmwh  marketindexprice_ppmwh  \\\n","date_sp                                                                     \n","2024-04-01 00:00:00           9.2           23.06                   27.54   \n","2024-04-01 00:30:00           9.2           23.06                   26.46   \n","2024-04-01 01:00:00           9.2           23.06                   25.19   \n","2024-04-01 01:30:00           9.2           23.06                   33.60   \n","2024-04-01 02:00:00           9.2           23.06                   47.54   \n","\n","                     sysprice_ppmwh  deratedmargin_mw  net_physnotif_mw  \\\n","date_sp                                                                   \n","2024-04-01 00:00:00       25.050000         21649.434              7106   \n","2024-04-01 00:30:00       25.650000         22028.758              7882   \n","2024-04-01 01:00:00       23.990000         22468.293              8109   \n","2024-04-01 01:30:00       76.000000         22108.607              8274   \n","2024-04-01 02:00:00       73.384327         22421.193              7733   \n","\n","                     dem_forecast_mw  gen_interconnector_