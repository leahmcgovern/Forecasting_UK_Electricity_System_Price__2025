tions > threshold\n","stress_pred_bool = test_y > threshold\n","\n","XGB_confusion_matrix = confusion_matrix(stress_test_bool, stress_pred_bool)\n","\n","cm_display = ConfusionMatrixDisplay(confusion_matrix = XGB_confusion_matrix, display_labels = [\"Negative\", \"Positive\"])\n","\n","cm_display.plot()\n","cm_display.ax_.set(\n","    title= 'Optimised XGBoost: Prediction of abnormally high system prices',\n","    xlabel= 'Predicted system price above threshold',\n","    ylabel= 'Test system price above threshold',\n","    cmap='Blues'\n",")\n","plt.show()\n","\n","print(f\"\\nPrecision score of: {precision_score(stress_test_bool, stress_pred_bool):.4f}, and a recall score of: {recall_score(stress_test_bool, stress_pred_bool):.4f}\")"]}],"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyP23skOYZ9Ix+ClleMC99VI"},"kernelspec":{"display_name":"Python 3","name":"python3"},"language_info":{"name":"python"}},"nbformat":4,"nbformat_minor":0}